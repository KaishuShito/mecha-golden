# Mac 側の中継 (bridge/live_bridge.py) が使う。GPT-Live (gpt-live-1) と Decisions API (gpt-6-luna) に使う
OPENAI_API_KEY=

# 本体だけ (Wi-Fi) で動かす時だけ。tools/provision.py で本体に書き込む。2.4GHz の Wi-Fi のみ
STACKCHAN_WIFI_SSID=
STACKCHAN_WIFI_PASS=
# 本体に入れるキー (省略すると provision.py --use-main-key で OPENAI_API_KEY を使う)
STACKCHAN_OPENAI_API_KEY=

# 鳴き声を作り直す時だけ (tools/eleven_sounds.py)。入れなくても、同梱の鳴き声で動く
ELEVENLABS_API_KEY=

# USB ポート (省略すると自動で探す)
# STACKCHAN_PORT=/dev/cu.usbmodem1101
